# SmartDesk AI - environment variables.
#
# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# NEVER put a real credential in THIS file - it is committed to git.
# .env is git-ignored and is the only place real values belong.

# --- PostgreSQL (Neon). Copy from the Neon dashboard.
# EITHER format works - the backend normalises the postgresql:// URI for Npgsql.
# QUOTE the URI form: it contains '&', which the shell treats as a job separator.
DATABASE_CONNECTION_STRING='postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require'
# ...or the key-value form:
# DATABASE_CONNECTION_STRING=Host=ep-xxxx-pooler.region.aws.neon.tech;Database=neondb;Username=USER;Password=PASSWORD;SSL Mode=Require

# --- JWT signing key. At least 32 characters. Generate a fresh one per environment:
#     openssl rand -base64 48
JWT_SECRET=

# --- Google Gemini (free tier: https://aistudio.google.com/apikey)
# If empty, the backend falls back to the deterministic ScriptedLlmClient, so the whole
# system still runs and demonstrates correctly with no key and no cost.
AI_API_KEY=

# --- Resend transactional email (free tier: https://resend.com)
# If empty, the backend uses NullEmailProvider, which still writes Notifications rows.
NOTIFICATION_API_KEY=

# Optional. Resend's free tier only sends to the address you registered with, and the seeded demo
# users have fictional @smartdesk.local addresses. Set this to your own address to see real
# emails arrive during a demonstration. The Notifications row still records the true recipient.
NOTIFICATION_REDIRECT_TO=

# --- Seed data password for the demo accounts (local development only)
SEED_PASSWORD=Password123!
